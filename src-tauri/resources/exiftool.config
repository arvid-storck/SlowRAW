# Nikon NEFInfo version 0100: eight signed rational coefficients, highest
# power first (r^8 through r), followed by a separate scalar. ExifTool's
# standard tags expose only the r^6, r^4 and r^2 coefficients.
# Layout/model reference: resources/licenses/vendor-lens.txt (ART).
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::Nikon::VignetteInfo' => {
        0x10 => {
            Name => 'NikonVignetteCoefficientCount',
            Format => 'int32u',
        },
        0x14 => {
            Name => 'NikonVignetteCoefficients',
            Format => 'rational64s[8]',
        },
    },
);
1;
